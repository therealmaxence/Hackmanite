# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackmanite?schema=public&connection_limit=10"


# ─── Session ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate_32_char_random_string_here_abcdef1234567890

# ─── Services ──────────────────────────────────────────────────────────────────
NLP_SERVICE_URL=http://nlp:8000

# ─── Upload ────────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── KuzuDB ───────────────────────────────────────────────────────────────────
# Kuzu pool size (recommended to be left empty for auto-scaling based on available memory)
KUZU_BUFFER_POOL_SIZE=
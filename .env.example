# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="file:./apps/web/prisma/dev.db?connection_limit=1&socket_timeout=900"


# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Session ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate_32_char_random_string_here_abcdef1234567890

# ─── Services ──────────────────────────────────────────────────────────────────
NLP_SERVICE_URL=http://nlp:8000

# ─── Upload ────────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Bull / Queue ──────────────────────────────────────────────────────────────
BULL_EXTRACTION_CONCURRENCY=10

# ─── KuzuDB ───────────────────────────────────────────────────────────────────
# Buffer pool size in bytes. Defaults to 1GB (1073741824 bytes).
KUZU_BUFFER_POOL_SIZE=1073741824
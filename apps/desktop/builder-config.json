{
  "appId": "com.datalake.hackmanite",
  "productName": "Hackmanite",
  "npmRebuild": false,
  "compression": "normal",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "preload.js",
    "splash.html",
    "hackmanite_main_nobg.png",
    "package.json",
    "node_modules/**/*",
    "hackmanite_main_icon.ico",
    "lib/**/*"
  ],
  "extraResources": [
    {
      "from": "../nlp-service/dist/hackmanite-nlp",
      "to": "nlp-service"
    },
    {
      "from": "../web",
      "to": "web",
      "filter": [
        "**/*",
        ".next-production/**/*",
        "!prisma/dev.db*",
        "!cache.json",
        "!uploads/**/*",
        "!node_modules_old/**/*",
        "!.next/cache/**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "hackmanite_main_icon.ico"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Utility",
    "maintainer": "maxence.ambert@etu.univ-savoie.fr",
    "icon": "hackmanite_main_nobg.png"
  }
}

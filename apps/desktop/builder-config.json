{
  "appId": "com.datalake.dagex",
  "productName": "DaGEx",
  "npmRebuild": false,
  "compression": "normal",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "preload.js",
    "splash.html",
    "package.json",
    "node_modules/**/*",
    "dagex_app.ico",
    "lib/**/*"
  ],
  "extraResources": [
    {
      "from": "../nlp-service/dist/dagex-nlp",
      "to": "nlp-service"
    },
    {
      "from": "../web",
      "to": "web",
      "filter": [
        "**/*",
        "!prisma/dev.db*",
        "!cache.json",
        "!uploads/**/*",
        "!node_modules_old/**/*",
        "!.next/cache/**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "dagex_app.ico"
  }
}

{
  "appId": "com.datalake.hackmanite",
  "productName": "Hackmanite",
  "npmRebuild": false,
  "compression": "maximum",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "preload.js",
    "splash.html",
    "hackmanite_main_nobg.png",
    "package.json",
    "node_modules/**/*",
    "hackmanite_main_icon.ico",
    "lib/**/*"
  ],
  "extraResources": [
    {
      "from": "../nlp-service/dist/hackmanite-nlp",
      "to": "nlp-service"
    },
    {
      "from": "../web",
      "to": "web",
      "filter": [
        "**/*",
        "!prisma/dev.db*",
        "!cache.json",
        "!uploads/**/*",
        "!node_modules_old/**/*",
        "!.next/**/*",
        "!next-production/cache/**/*",
        "!logs/**/*",
        "!docs/**/*",
        "!tests/**/*",
        "!test/**/*",
        "!playwright-report/**/*",
        "!test-results/**/*",
        "!node_modules/@playwright/**/*",
        "!node_modules/.cache/**/*",
        "!node_modules/typedoc/**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "hackmanite_main_icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Utility",
    "icon": "hackmanite_main_nobg.png"
  }
}
